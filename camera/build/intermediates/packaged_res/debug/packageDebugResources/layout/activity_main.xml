<?xml version="1.0" encoding="utf-8"?>

                                                       
                                                   

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        tools:context=".ui.MainActivity" android:tag="layout/activity_main_0" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingBottom="24dp">

                <!-- App name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/teal_200"
                    android:layout_marginBottom="16dp" />

                <!-- Status badge -->
                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_stopped"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="8dp"
                    android:background="@drawable/bg_status_stopped"
                    android:layout_marginBottom="24dp" />

                <!-- Start/Stop button -->
                <Button
                    android:id="@+id/btnStartStop"
                    android:layout_width="240dp"
                    android:layout_height="64dp"
                    android:text="@string/btn_start"
                    android:textSize="18sp"
                    android:backgroundTint="@color/green_200"
                    android:layout_marginBottom="24dp" />

                <!-- Info card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/dark_surface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/info_stream_address"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/teal_200"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvStreamAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="rtsp://..."
                            android:textSize="14sp"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:id="@+id/tvUptime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/info_uptime"
                            android:textSize="14sp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvResolutionFpsBitrate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/info_resolution_fps_bitrate"
                            android:textSize="14sp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvBattery"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/info_battery"
                            android:textSize="14sp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvStorageFree"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/info_storage_free"
                            android:textSize="14sp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvStorageUsed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/info_storage_used"
                            android:textSize="14sp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvEventsToday"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/info_events_today"
                            android:textSize="14sp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvMotion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/info_motion"
                            android:textSize="14sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Preview toggle -->
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchPreview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/preview_toggle"
                    android:textSize="16sp"
                    android:layout_marginBottom="24dp" />

                <!-- Action buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/btnSettings"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="@string/btn_settings" />

                    <Button
                        android:id="@+id/btnPairing"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/btn_pairing" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btnLogs"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="@string/btn_logs" />

                    <Button
                        android:id="@+id/btnDimScreen"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/btn_dim_screen" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
         