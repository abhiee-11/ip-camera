<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/carbon"
        tools:context=".ui.MainActivity">

        <!-- App bar -->
        <LinearLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvCameraName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/bone"
                android:textSize="@dimen/text_name"
                android:textStyle="bold"
                tools:text="Front door" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="@dimen/icon_button"
                android:layout_height="@dimen/icon_button"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_settings"
                android:src="@drawable/ic_sliders"
                app:tint="@color/mute" />

            <ImageButton
                android:id="@+id/btnOverflow"
                android:layout_width="@dimen/icon_button"
                android:layout_height="@dimen/icon_button"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu_more"
                android:src="@drawable/ic_overflow"
                app:tint="@color/mute" />
        </LinearLayout>

        <!-- Fault banner -->
        <LinearLayout
            android:id="@+id/bannerFault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_banner_fault"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/appBar"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvFaultTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tape"
                android:textSize="@dimen/text_label"
                android:textStyle="bold"
                tools:text="Encoder stopped" />

            <TextView
                android:id="@+id/tvFaultMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/mute"
                android:textSize="@dimen/text_meta"
                tools:text="Camera was closed by another app. Restart to resume streaming." />
        </LinearLayout>

        <!-- State block -->
        <LinearLayout
            android:id="@+id/stateBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/bannerFault">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStateBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_mute"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.12"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="@string/state_stopped"
                    android:textColor="@color/mute"
                    android:textSize="@dimen/text_mono" />

                <TextView
                    android:id="@+id/tvStateClock"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:text="00:00:00"
                    android:textColor="@color/bone"
                    android:textSize="@dimen/text_clock"
                    tools:text="04:12:37" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStateSubLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/mute"
                android:textSize="@dimen/text_meta"
                tools:text="streaming / configured 640x480 / 15fps / 500 kbps" />
        </LinearLayout>

        <!-- Preview surface -->
        <FrameLayout
            android:id="@+id/previewContainer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/preview_height"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:background="@color/panel"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/stateBlock"
            tools:visibility="visible">

            <com.pedro.library.view.OpenGlView
                android:id="@+id/previewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- Primary action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrimary"
            style="@style/Widget.FreeCam.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="16dp"
            android:text="@string/action_start_streaming"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/previewContainer" />

        <!-- Secondary tiles -->
        <LinearLayout
            android:id="@+id/tilesRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/btnPrimary">

            <LinearLayout
                android:id="@+id/tilePreview"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/tile_preview"
                    android:src="@drawable/ic_preview"
                    app:tint="@color/sodium" />

                <TextView
                    android:id="@+id/tvTilePreview"
                    style="@style/Widget.FreeCam.TileLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/tile_preview" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tilePairing"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/tile_pair_viewer"
                    android:src="@drawable/ic_qr"
                    app:tint="@color/sodium" />

                <TextView
                    android:id="@+id/tvTilePairing"
                    style="@style/Widget.FreeCam.TileLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/tile_pair_viewer" />
            </LinearLayout>
        </LinearLayout>

        <!-- Telemetry -->
        <ScrollView
            android:id="@+id/telemetryScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilesRow">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <TextView
                    style="@style/Widget.FreeCam.SectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_telemetry" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp">

                    <TextView
                        style="@style/Widget.FreeCam.ReadoutLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_address" />

                    <TextView
                        android:id="@+id/tvAddress"
                        style="@style/Widget.FreeCam.ReadoutValueMono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/value_unknown"
                        tools:text="100.64.0.5" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/rule_width"
                    android:background="@color/rule" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp">

                    <TextView
                        style="@style/Widget.FreeCam.ReadoutLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_tailnet" />

                    <TextView
                        android:id="@+id/tvTailnet"
                        style="@style/Widget.FreeCam.ReadoutValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/value_tailnet_absent" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/rule_width"
                    android:background="@color/rule" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp">

                    <TextView
                        style="@style/Widget.FreeCam.ReadoutLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_battery" />

                    <TextView
                        android:id="@+id/tvBattery"
                        style="@style/Widget.FreeCam.ReadoutValueMono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/value_unknown" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/rule_width"
                    android:background="@color/rule" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp">

                    <TextView
                        style="@style/Widget.FreeCam.ReadoutLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_recordings" />

                    <TextView
                        android:id="@+id/tvStorage"
                        style="@style/Widget.FreeCam.ReadoutValueMono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/value_unknown" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/rule_width"
                    android:background="@color/rule" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp">

                    <TextView
                        style="@style/Widget.FreeCam.ReadoutLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_motion" />

                    <TextView
                        android:id="@+id/tvMotion"
                        style="@style/Widget.FreeCam.ReadoutValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/value_motion_unavailable" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/rule_width"
                    android:background="@color/rule" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp">

                    <TextView
                        style="@style/Widget.FreeCam.ReadoutLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_events_today" />

                    <TextView
                        android:id="@+id/tvEventsToday"
                        style="@style/Widget.FreeCam.ReadoutValueMono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/value_unknown" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
