<resources>
    <!-- Base application theme (Dark) -->
    <style name="Theme.FreeCamViewer" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_dark</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/primary_variant</item>
        <item name="colorOnSecondary">@color/on_dark</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/dark_bg</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/on_dark</item>
    </style>

    <style name="Theme.FreeCamViewer.NoActionBar" parent="Theme.FreeCamViewer">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.FreeCamViewer.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar" />

    <style name="Theme.FreeCamViewer.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Light" />
</resources>